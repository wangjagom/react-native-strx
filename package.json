{
  "name": "react-native-strx",
  "version": "1.0.0-beta.0",
  "description": "Tailwind-style declarative animations, layout transitions, and component adapters for React Native Reanimated.",
  "keywords": [
    "react-native",
    "reanimated",
    "animation",
    "layout-animation",
    "tailwind",
    "transition"
  ],
  "license": "MIT",
  "author": "wangjagom",
  "homepage": "https://github.com/wangjagom/react-native-strx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangjagom/react-native-strx.git"
  },
  "bugs": {
    "url": "https://github.com/wangjagom/react-native-strx/issues"
  },
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "types": "./lib/typescript/src/index.d.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "tokens.json",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "test": "jest",
    "docs:tokens": "UPDATE_DOCS=1 jest scripts/__tests__/tokenReference.test.ts",
    "build": "bob build",
    "clean": "rm -rf lib",
    "pack:check": "npm pack --dry-run",
    "prepare": "bob build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run pack:check",
    "publish:npm": "npm publish --access public",
    "npm:whoami": "npm whoami",
    "changeset": "changeset",
    "version-packages": "changeset version && npm run docs:tokens"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.78",
    "react-native-reanimated": ">=4.1.0",
    "react-native-worklets": ">=0.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/eslint-config": "^0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@react-native/typescript-config": "^0.87.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "react": "^19.2.3",
    "react-native": "^0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-worklets": "^0.13.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./debug": {
      "source": "./src/debug/index.ts",
      "types": "./lib/typescript/src/debug/index.d.ts",
      "default": "./lib/module/debug/index.js"
    },
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "{**/__tests__/**,**/__fixtures__/**,**/__mocks__/**,**/*.d.ts}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/",
      "<rootDir>/example/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|react-native-reanimated|react-native-worklets)/)"
    ],
    "resolver": "react-native-reanimated/jest/resolver.js"
  }
}
